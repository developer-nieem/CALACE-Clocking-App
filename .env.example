DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true

# Local Postgres from Docker Desktop (npm run db:up):
# DEMO_MODE=false
# NEXT_PUBLIC_DEMO_MODE=false
# DATABASE_URL=postgresql://calace:calace_dev@localhost:5433/calace_team

# Production on Vercel + Neon PostgreSQL:
# DEMO_MODE=false
# NEXT_PUBLIC_DEMO_MODE=false
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
#
# Use the pooled Neon connection string from the Vercel Neon integration.
# Do not commit the real connection string.

CALACE_SEED_DEMO=true
# Production: CALACE_SEED_DEMO=false so an empty database is not filled with demo employees.

# Dual-write JSON snapshots by default. After parity, set:
# CALACE_JSON_WRITES=false
# CALACE_JSON_STORE=read_only

NEXT_PUBLIC_APP_URL=http://localhost:3000
# Staging only:
# NEXT_PUBLIC_APP_ENV=staging

# Optional. In-app notifications work without these.
# RESEND_API_KEY=
# EMAIL_FROM=CAL ACE <notifications@example.com>

# Optional. Calendar connect stays disabled until both values exist.
# The app does not pretend a connection succeeded.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_REDIRECT_URI=
# AI_PROVIDER=
# OPENAI_API_KEY=
# CRON_SECRET=
# APP_ENCRYPTION_KEY=
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# Distributed rate limiting (required in production unless CALACE_ALLOW_MEMORY_RATE_LIMIT=true)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# CALACE_ALLOW_MEMORY_RATE_LIMIT=false

# Set true only after two-tenant RLS tests against the live database.
# CALACE_RLS_VERIFIED=false

# Staging-only Sentry probe:
# CALACE_ALLOW_ERROR_TEST=false
